# ==========================================================================
# CONFIGURAÇÕES GERAIS (Aplicadas a todo o projeto)
# ==========================================================================
# Arquivos de ambiente e segredos
.env
.env.*
*.local

# Logs e arquivos de sistema
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.DS_Store
Thumbs.db

# Ferramentas de IDE (Global)
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath
.apt_generated
.springBeans
.sts4-cache

# ==========================================================================
# FRONTEND (React / Node.js)
# ==========================================================================

/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/.cache/
/frontend/.eslintcache
/frontend/.stylelintcache
/frontend/.npm/
/frontend/.yarn/
/frontend/.pnpm-debug.log

# Se houver arquivos de configuração específicos do front
/frontend/.env.production
/frontend/.env.development

# ==========================================================================
# BACKEND (Spring Boot / Maven / Gradle)
# ==========================================================================

/backend/target/
/backend/.mvn/
/backend/.gradle/
/backend/build/
/backend/out/
/backend/reports/

# Regras específicas do Maven/Gradle para não ignorar fontes
!**/src/main/**/target/
!**/src/test/**/target/

# Arquivos de documentação e dados
HELP.md
/backend/data/