# Banco de dados (MySQL)
DB_USER="user"
DB_PASSWORD="change-me"

# JWT: gere com `openssl rand -base64 48`
JWT_SECRET="change-me"

# Domínio base: os servidores são acessados por <nome>-<id>.BASE_DOMAIN
BASE_DOMAIN="example.com.br"

# Diretório onde os dados dos servidores Minecraft são gravados
DATA_ROOT_DIRECTORY="caminho/para/os/servidores"